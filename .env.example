PORT=3000
NODE_ENV=development

# URL del proyecto en Supabase (Settings > API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Usa la service_role solo en el servidor. Nunca la expongas al frontend.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Secreto para firmar JWT (cadena larga y aleatoria)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
